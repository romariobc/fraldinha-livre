# Vars de build-time de producao — NEXT_PUBLIC_* sao publicas por design (vao pro bundle do cliente).
# Ver .claude/docs/decisoes.md (deploy real C11, feature 007).
NEXT_PUBLIC_USE_BACKEND=true
NEXT_PUBLIC_BACKEND_URL=https://fraldinha-livre-backend.romariobc.workers.dev

# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN de producao fica em .env.production.local (nao
# aqui) - .env.local (worktree, tem o valor de dev) tem prioridade sobre este
# arquivo no Next.js, entao um override aqui seria silenciosamente ignorado.
# So .env.production.local (prioridade maior que .env.local) resolve isso.

# Firebase Web config — projeto fraldinha-livre (conta romariobc@gmail.com). Faltava
# aqui desde sempre: todo deploy anterior era feito manualmente de uma maquina de dev
# que ja tinha .env.local (gitignored) com esses valores, entao o gap nunca apareceu
# ate a primeira build de verdade num clone limpo (D-037, 2026-07-30) — o build
# quebrou em "Firebase: Error (auth/invalid-api-key)" ao prerenderizar /_not-found.
# Mesmo valor usado em dev (.env.local); nao ha conflito com .env.local que justifique
# colocar em .env.production.local (diferente do authDomain, D-035).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBPsjYjlaTKJ7KuP-SMd2O6M878hKNG2Vw
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fraldinha-livre
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fraldinha-livre.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=870655271908
NEXT_PUBLIC_FIREBASE_APP_ID=1:870655271908:web:1c9205f6f593ec1ea3ddf1
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-FJ8NXW9C9G
