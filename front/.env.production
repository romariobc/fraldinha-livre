# Vars de build-time de producao — NEXT_PUBLIC_* sao publicas por design (vao pro bundle do cliente).
# Ver .claude/docs/decisoes.md (deploy real C11, feature 007).
NEXT_PUBLIC_USE_BACKEND=true
NEXT_PUBLIC_BACKEND_URL=https://fraldinha-livre-backend.romariobc.workers.dev

# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN de producao fica em .env.production.local (nao
# aqui) - .env.local (worktree, tem o valor de dev) tem prioridade sobre este
# arquivo no Next.js, entao um override aqui seria silenciosamente ignorado.
# So .env.production.local (prioridade maior que .env.local) resolve isso.
