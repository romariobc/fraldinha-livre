{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fraldinha-livre-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fraldinha-livre-db",
      // D1 real, criado via MCP cloudflare-bindings em 2026-07-19 (antecipado da B9)
      "database_id": "a6da1bcf-ed51-4c8a-8dcb-cfd0c6c9e612"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // RESEND_API_KEY e' secret (wrangler secret put RESEND_API_KEY), nunca commitado aqui.
  "vars": {
    "FIREBASE_PROJECT_ID": "fraldinha-livre",
    "NOTIFICATIONS_ENABLED": "false",
  }
}
