# Exemplo de configuração para execução do script de QA autenticado
# Para usar, crie o arquivo .env.qa.local na raiz do projeto (que é ignorado pelo Git)
# e preencha as variáveis abaixo:

QA_BUYER_EMAIL=comprador.teste@fraldinhalivre.com.br
QA_BUYER_PASSWORD=
QA_SUPPLIER_EMAIL=fornecedor.teste1@fraldinhalivre.com.br
QA_SUPPLIER_PASSWORD=

# Credenciais administrativas para integração e observabilidade da API (Passo 12)
# Devem vir exclusivamente de variáveis de ambiente seguras (sem credenciais hardcoded)
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_REQUIRE_ADMIN=false

# Trava de segurança contra produção (Fail-Closed):
# Por padrão, execuções com escrita são bloqueadas contra ambientes de produção com status "NÃO EXECUTADO" e exit code 2.
# Pedidos de compra direta criados no D1 não possuem rota de exclusão por razões contábeis e de integridade.
# Para testes com isolamento integral, execute em ambiente local ou preview.
# Para autorização explícita e excepcional de escrita em produção:
# QA_ALLOW_PRODUCTION_WRITE=true
