# Exemplo de configuração para execução do script de QA autenticado
# Para usar, crie o arquivo .env.qa.local na raiz do projeto (que é ignorado pelo Git)
# e preencha as variáveis abaixo:

QA_BUYER_EMAIL=comprador.teste@fraldinhalivre.com.br
QA_BUYER_PASSWORD=
QA_SUPPLIER_EMAIL=fornecedor.teste1@fraldinhalivre.com.br
QA_SUPPLIER_PASSWORD=

# Para permitir testes de escrita em produção (criação de pedidos reais no D1), defina:
# QA_ALLOW_PRODUCTION_WRITE=true
